<Window x:Class="WARBIMPRO.ShellExtension.Views.RevitInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WARBIMPRO — Info del proyecto"
        Width="440" Height="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <SolidColorBrush x:Key="BgDeep"      Color="#0D0F14"/>
        <SolidColorBrush x:Key="BgPanel"     Color="#13161D"/>
        <SolidColorBrush x:Key="BgCard"      Color="#1A1E28"/>
        <SolidColorBrush x:Key="AccentGold"  Color="#F0A500"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F2F5"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#5A6070"/>
        <SolidColorBrush x:Key="TextLabel"   Color="#8A95A8"/>
        <SolidColorBrush x:Key="Border"      Color="#252A38"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextLabel}"/>
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin"     Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="6,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A0000"/>
                                <Setter Property="Foreground" Value="#FF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12"
            Background="{StaticResource BgDeep}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <!-- Título -->
                <RowDefinition Height="Auto"/>
                <!-- Header nombre -->
                <RowDefinition Height="*"/>
                <!-- Contenido -->
                <RowDefinition Height="40"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- BARRA TÍTULO -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgPanel}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="{StaticResource AccentGold}" Margin="0,0,10,0">
                            <TextBlock Text="W" FontFamily="Consolas" FontWeight="Bold"
                                       FontSize="15" Foreground="#0D0F14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="WARBIMPRO" FontFamily="Consolas" FontWeight="Bold"
                                   FontSize="12" Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  Shell Info" FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource CloseBtn}"
                            Content="✕" Click="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- HEADER nombre de archivo -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgCard}"
                    BorderBrush="{StaticResource AccentGold}"
                    BorderThickness="0,0,0,2"
                    Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="TxtFileName"
                               FontFamily="Consolas" FontWeight="Bold" FontSize="16"
                               Foreground="{StaticResource AccentGold}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtFilePath"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- CONTENIDO: 4 tarjetas en grid 2x2 -->
            <Grid Grid.Row="2" Margin="16,16,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Versión Revit -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="VERSIÓN REVIT" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtRevitVersion" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Tamaño -->
                <Border Grid.Row="0" Grid.Column="2"
                        Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="TAMAÑO" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtFileSize" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Fecha creación -->
                <Border Grid.Row="2" Grid.Column="0"
                        Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="FECHA CREACIÓN" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtCreated" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Última modificación -->
                <Border Grid.Row="2" Grid.Column="2"
                        Background="{StaticResource BgCard}" CornerRadius="8" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="ÚLTIMA MODIFICACIÓN" Style="{StaticResource LabelStyle}"/>
                        <TextBlock x:Name="TxtLastModified" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- FOOTER -->
            <Border Grid.Row="3"
                    Background="{StaticResource BgPanel}"
                    CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <TextBlock Text="WARBIMPRO Shell Extension"
                               FontFamily="Consolas" FontSize="10"
                               Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center"/>

                    <!-- Badge workshared (solo si aplica) -->
                    <Border x:Name="BadgeWorkshared" HorizontalAlignment="Right"
                            CornerRadius="8" Padding="8,2"
                            Background="#1A2B1A" Visibility="Collapsed"
                            VerticalAlignment="Center">
                        <TextBlock Text="⚡ WORKSHARED" FontFamily="Consolas" FontSize="9"
                                   FontWeight="Bold" Foreground="#4EC94E"/>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
