<?xml version="1.0" encoding="utf-8"?>
<!--
  WARBIMPRO.ShellExtension.csproj
  ─────────────────────────────────────────────────────────────────────────────
  Proyecto Class Library para la Shell Extension de Windows.
  
  IMPORTANTE: Debe ser .NET Framework 4.8, NO .NET 6/7/8.
  Las Shell Extensions COM de Windows solo funcionan con .NET Framework.
  ─────────────────────────────────────────────────────────────────────────────
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET Framework 4.8: requerido para Shell Extensions COM en Windows -->
    <TargetFramework>net48</TargetFramework>

    <!-- Siempre x64 para coincidir con Revit y Windows moderno -->
    <PlatformTarget>x64</PlatformTarget>

    <!-- Necesario para registrar como COM con regasm -->
    <RegisterForComInterop>false</RegisterForComInterop>

    <!-- Genera el archivo .tlb necesario para COM (regasm lo usa) -->
    <GenerateSerializationAssemblies>Off</GenerateSerializationAssemblies>

    <AssemblyName>WARBIMPRO.ShellExtension</AssemblyName>
    <RootNamespace>WARBIMPRO.ShellExtension</RootNamespace>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="Properties\**" />
    <Page Remove="Properties\**" />
  </ItemGroup>

  <!-- ───── NuGet Packages ───── -->
  <ItemGroup>
    <!--
      SharpShell: simplifica enormemente el desarrollo de Shell Extensions COM.
      Sin esta librería habría que implementar interfaces COM manualmente (muy complejo).
    -->
    <PackageReference Include="SharpShell" Version="2.7.2" />

    <!--
      OpenMcdf: lee archivos OLE Compound Document (.rvt, .xls, .doc antiguos, etc.)
      Los .rvt son este tipo de archivo — contienen streams internos como BasicFileInfo.
    -->
    <PackageReference Include="OpenMcdf" Version="2.3.1" />
  </ItemGroup>

  <!-- ───── Resources ───── -->
  <ItemGroup>
    <Folder Include="Models\" />
    <Folder Include="Resources\" />
    <Folder Include="Views\" />
    <Folder Include="Services\" />
  </ItemGroup>

</Project>
