<Window x:Class="WARBIMPRO.Views.TranferTemplatesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WARBIMPRO.Views"
      mc:Ignorable="d" 
      Height="700" Width="350"
      WindowStartupLocation="CenterScreen"
      WindowStyle="None"
      AllowsTransparency="True"
      Title="TranferTemplatesView">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Sombra exterior -->
    <Border CornerRadius="10" Background="#2C2C54">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════ -->
            <!-- BARRA DE TÍTULO PERSONALIZADA              -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#23234A"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28"
                                Background="#3498db"
                                CornerRadius="6"
                                Margin="0,0,10,0">
                            <Path Data="M8 5v14l11-7z"
                                  Fill="White"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Transfer View Templates"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="WARBIMPRO · Revit Tools"
                                       Foreground="#6060A0"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE949;"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeWindow_Click"
                                ToolTip="Minimizar"/>
                        <Button Content="&#xE8BB;"
                                Click="CloseWindow_Click"
                                ToolTip="Cerrar">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Separador con gradiente -->
            <Rectangle Grid.Row="1" Height="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3498db" Offset="0"/>
                        <GradientStop Color="#4B4B7A" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ══════════════════════════════════════════ -->
            <!-- CONTENIDO PRINCIPAL                        -->
            <!-- ══════════════════════════════════════════ -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Style="{x:Null}">
                <StackPanel Margin="20,20,20,10">

                    <!-- ── MODELO ORIGEN ── -->
                    <TextBlock Text="MODELO ORIGEN"
                               Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding OpenDocuments}"
                              SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="Title"
                              Margin="0,0,0,4"/>
                    <TextBlock Text="Selecciona el documento del que copiarás los templates."
                               Foreground="White"
                               FontSize="11"
                               Margin="0,0,0,18"/>

                    <!-- ── MODELO DESTINO ── -->
                    <TextBlock Text="MODELO DESTINO"
                               Style="{StaticResource SectionLabelStyle}"/>
                    <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                              ItemsSource="{Binding OpenDocuments}"
                              SelectedItem="{Binding SelectedTarget}"
                              DisplayMemberPath="Title"
                              Margin="0,0,0,4"/>
                    <TextBlock Text="Selecciona el documento de destino donde se copiará el template."
                               Foreground="White"
                               FontSize="11"
                               Margin="0,0,0,18"/>

                    <!-- ── VIEW TEMPLATES: header con contador ── -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="VIEW TEMPLATES"
                                   Style="{StaticResource SectionLabelStyle}"
                                   VerticalAlignment="Center"/>
                        <Border Grid.Column="1"
                                Background="#3498db"
                                CornerRadius="10"
                                Padding="8,2">
                            <TextBlock Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} templates">
                                        <Binding Path="FilteredTemplates.Count" FallbackValue="0"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- ── Buscador ── -->
                    <Grid Margin="0,0,0,8">
                        <TextBox Style="{StaticResource InlineSearchStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>

                    <!-- ── Lista de templates con CheckBox ── -->
                    <Border BorderBrush="#4B4B7A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Height="280">
                        <ListBox Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding FilteredTemplates}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#3A3A60"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#353560"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Content="{Binding Name}"
                                              Style="{StaticResource CheckBoxStyle}"
                                              Padding="8,10"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ══════════════════════════════════════════ -->
            <!-- FOOTER CON BOTONES                         -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#23234A"
                    CornerRadius="0,0,10,10"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Botones selección -->
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Spacer -->
                        <ColumnDefinition Width="*"/>
                        <!-- Botón copiar -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Seleccionar todos -->
                    <Button Grid.Column="0"
                            Command="{Binding SelectAllCommand}"
                            Height="34"
                            Padding="12,0"
                            Width="100"
                            Margin="0,0,0,0"
                            Cursor="Hand"
                            ToolTip="Seleccionar todos">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3A3A5C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#4B4B7A"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Ícono check-all -->
                                                    <Path Data="M2 7h14v2H2zm0 4h14v2H2zm0 4h14v2H2z"
                                                          Fill="#3498db"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          Margin="0,0,6,0"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4B4B7A"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#2C2C54"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Todos" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Limpiar selección -->
                    <Button Grid.Column="1"
                            Command="{Binding SelectNoneCommand}"
                            Height="34"
                            Padding="12,0"
                            Width="100"
                            Cursor="Hand"
                            ToolTip="Limpiar selección" Grid.ColumnSpan="2" >
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3A3A5C"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#4B4B7A"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Ícono clear -->
                                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                          Fill="#E74C3C"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          Margin="0,0,6,0"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#4B4B7A"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#2C2C54"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Ninguno" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Botón Copiar -->
                    <Button Grid.Column="3"
                            Command="{Binding CopyCommand}"
                            Height="34"
                            Width="100"
                            Padding="18,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498db"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                                          Fill="White"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          Margin="0,0,8,0"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2980b9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1f6fa3"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#4B4B7A"/>
                                                    <Setter Property="Foreground" Value="#7A7AAA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Copiar" VerticalAlignment="Center"/>
                    </Button>

                </Grid>
            </Border>

        </Grid>
    </Border>

</Window>
