<Window x:Class="WARBIMPRO.Views.RoadSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sección Tipo — Vía"
        Width="380" Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="16">

        <TextBlock Text="Parámetros de la vía"
                   FontSize="14" FontWeight="SemiBold"
                   Margin="0,0,0,16"/>

        <!-- Ancho -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Ancho de vía (m):" Width="220" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtWidth" Text="6.0" Height="26" Padding="4,0"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Pendiente transversal -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Pendiente transversal (%):" Width="220" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCrossSlope" Text="2.0" Height="26" Padding="4,0"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Cota de inicio -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Cota inicio eje (m):" Width="220" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtStartElev" Text="0.0" Height="26" Padding="4,0"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Pendiente longitudinal -->
        <DockPanel Margin="0,0,0,8">
            <TextBlock Text="Pendiente longitudinal (%):" Width="220" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtLongSlope" Text="5.0" Height="26" Padding="4,0"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Espaciado -->
        <DockPanel Margin="0,0,0,0">
            <TextBlock Text="Espaciado estaciones (m):" Width="220" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSpacing" Text="5.0" Height="26" Padding="4,0"
                     VerticalContentAlignment="Center"/>
        </DockPanel>

        <!-- Nota informativa -->
        <Border Background="#EBF8FF" BorderBrush="#90CDF4" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0,12,0,0">
            <TextBlock Text="ℹ  La pendiente longitudinal se aplica desde la cota de inicio hacia el final del eje."
                       FontSize="11" TextWrapping="Wrap" Foreground="#2C5282"/>
        </Border>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="80" Height="30"
                    Margin="0,0,8,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnOk" Content="Crear Vía" Width="100" Height="30"
                    IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>

    </StackPanel>
</Window>
