<Window x:Class="WARBIMPRO.Views.RoadSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sección Tipo — Vía y Andenes"
        Width="400" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- VÍA -->
            <TextBlock Text="Vía" FontSize="13" FontWeight="SemiBold"
                       Foreground="#2B6CB0" Margin="0,0,0,8"/>

            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Ancho de vía (m):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtWidth" Text="6.0" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Pendiente transversal (%):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtCrossSlope" Text="2.0" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Cota inicio eje (m):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtStartElev" Text="0.0" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Pendiente longitudinal (%):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtLongSlope" Text="5.0" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Espaciado estaciones (m):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSpacing" Text="5.0" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>

            <Separator Margin="0,10,0,10"/>

            <!-- ANDÉN IZQUIERDO -->
            <TextBlock Text="Andén Izquierdo" FontSize="13" FontWeight="SemiBold"
                       Foreground="#276749" Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkLeftSidewalk" Content="Incluir andén izquierdo"
                      IsChecked="True" Margin="0,0,0,6"
                      Checked="ChkSidewalk_Changed" Unchecked="ChkSidewalk_Changed"/>
            <DockPanel x:Name="PanelLeft" Margin="0,0,0,6">
                <TextBlock Text="Ancho andén izq. (m):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtLeftWidth" Text="1.5" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>

            <Separator Margin="0,10,0,10"/>

            <!-- ANDÉN DERECHO -->
            <TextBlock Text="Andén Derecho" FontSize="13" FontWeight="SemiBold"
                       Foreground="#276749" Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkRightSidewalk" Content="Incluir andén derecho"
                      IsChecked="True" Margin="0,0,0,6"
                      Checked="ChkSidewalk_Changed" Unchecked="ChkSidewalk_Changed"/>
            <DockPanel x:Name="PanelRight" Margin="0,0,0,6">
                <TextBlock Text="Ancho andén der. (m):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtRightWidth" Text="1.5" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>

            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Pendiente andenes (%):" Width="220" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtSidewalkSlope" Text="3.0" Height="26" Padding="4,0"
                         VerticalContentAlignment="Center"/>
            </DockPanel>

            <!-- Botones -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar" Width="80" Height="30"
                        Margin="0,0,8,0" Click="BtnCancel_Click"/>
                <Button Content="Crear Vía" Width="100" Height="30"
                        IsDefault="True" Click="BtnOk_Click"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
