<Window x:Class="WARBIMPRO.Views.BimFamilyCreatorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:WARBIMPRO.ViewModels"
        
      
        Title="BIM Family Creator — WARBIMPRO"
        Width="780" Height="680"
        MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#1E1E42"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TITLEBAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#16163A" BorderBrush="#4B4B7A" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Width="26" Height="26" CornerRadius="5" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3498DB" Offset="0"/>
                                <GradientStop Color="#4B4B7A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="AI" Foreground="White" FontWeight="Black"
                                   FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="BIM Family Creator"
                               Style="{StaticResource TextBlockStyle}"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0"/>
                    <Border Margin="10,0,0,0" CornerRadius="10"
                            Background="#1E2847" BorderBrush="#3498DB" BorderThickness="1" Padding="7,2">
                        <TextBlock Text="CLAUDE AI" Foreground="#3498DB" FontSize="9"
                                   FontWeight="Bold" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>

                <Border HorizontalAlignment="Center" CornerRadius="10"
                        Background="#1A2A1A" BorderBrush="#2A5A2A" BorderThickness="1" Padding="8,3">
                    <TextBlock Text="{Binding StatusText}" Foreground="#22C55E"
                               FontSize="9" FontFamily="Consolas" FontWeight="Bold"
                               MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button Content="&#xE106;" Style="{StaticResource WindowButtonStyle}"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Button Content="&#xE949;" Style="{StaticResource WindowButtonStyle}"
                        Click="MinimizeButton_Click"
                        HorizontalAlignment="Right" Margin="0,0,40,0"/>
            </Grid>
        </Border>

        <!-- ══ CONTENIDO PRINCIPAL ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="14,12,14,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- SECCIÓN: Imagen -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <Ellipse Width="7" Height="7" Fill="#3498DB" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="IMAGEN DEL MUEBLE" Style="{StaticResource SectionLabelStyle}"
                           Margin="0" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="5" Background="#16163A"
                        BorderBrush="#4B4B7A" BorderThickness="1">
                    <TextBlock Text="{Binding ImagePath}" Foreground="#CCCCEE"
                               FontFamily="Consolas" FontSize="11" Padding="10,7"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>

                <Button Grid.Column="1" Margin="6,0,0,0"
                        Style="{StaticResource BtnSecondary}"
                        Command="{Binding BrowseImageCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="12" Margin="0,0,5,0"/>
                        <TextBlock Text="Explorar"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Margin="6,0,0,0"
                        Style="{StaticResource BtnSecondary}"
                        Command="{Binding LoadJsonCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock  FontFamily="Consolas" FontSize="11" Margin="0,0,5,0"/>
                        <TextBlock Text="Cargar JSON"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- SECCIÓN: Prompt -->
            <StackPanel Grid.Row="2">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Ellipse Width="7" Height="7" Fill="#3498DB" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="INSTRUCCIONES PARA CLAUDE (EDITABLE)"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" CornerRadius="8"
                            Background="#0E3A20" BorderBrush="#22C55E" BorderThickness="1" Padding="6,1">
                        <TextBlock Text="EDITABLE" Foreground="#22C55E"
                                   FontSize="8" FontWeight="Bold" FontFamily="Consolas"/>
                    </Border>
                    <Button Margin="8,0,0,0" Style="{StaticResource BtnReset}"
                            Command="{Binding ResetPromptCommand}"
                            ToolTip="Restaurar prompt por defecto">
                        <TextBlock Text="↺ Reset" FontSize="10"/>
                    </Button>
                </StackPanel>

                <Border CornerRadius="5" Background="#16163A"
                        BorderBrush="#4B4B7A" BorderThickness="1">
                    <TextBox Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="#CCCCEE" Background="Transparent"
                             BorderThickness="0" FontFamily="Consolas" FontSize="10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             CaretBrush="#3498DB" Padding="10,8"
                             MinHeight="80" MaxHeight="120"/>
                </Border>
            </StackPanel>

            <!-- SECCIÓN: JSON output -->
            <StackPanel Grid.Row="3" Margin="0,10,0,6">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock Text="JSON GENERADO (EDITABLE ANTES DE CREAR)"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="4" CornerRadius="5" Background="#16163A"
                    BorderBrush="#4B4B7A" BorderThickness="1">
                <TextBox Text="{Binding JsonOutput, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="#22C55E" Background="Transparent"
                         BorderThickness="0" FontFamily="Consolas" FontSize="10"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         CaretBrush="#3498DB" Padding="10,8"/>
            </Border>
        </Grid>

        <!-- ══ PROGRESS (visible solo mientras analiza) ══════════════════════ -->
        <Border Grid.Row="2" Background="#16163A" Padding="14,6"
                Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Border Width="8" Height="8" CornerRadius="4"
                        Background="#3498DB" Margin="0,0,8,0">
                    <Border.RenderTransform>
                        <RotateTransform CenterX="4" CenterY="4"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.Angle"
                                        From="0" To="360" Duration="0:0:1"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
                <TextBlock Text="Analizando imagen con Claude API..."
                           Foreground="#3498DB" FontFamily="Consolas"
                           FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ══ ACTION BAR ════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="#16163A" BorderBrush="#4B4B7A" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource BtnReset}"
                        Command="{Binding OpenConfigCommand}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="13" Margin="0,0,5,0"/>
                        <TextBlock Text="API Key"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="1" CornerRadius="20" Background="#2C2C54"
                        BorderBrush="#4B4B7A" BorderThickness="1"
                        Padding="12,5" Margin="0,0,8,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="#7A7AAA"
                               FontSize="11" FontFamily="Consolas"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Border>

                <Button Grid.Column="2" Margin="0,0,6,0"
                        Style="{StaticResource BtnSecondary}"
                        Command="{Binding AnalyzeCommand}"
                        >
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="13" Margin="0,0,5,0"/>
                        <TextBlock Text="Analizar imagen"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" 
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding CreateFamilyCommand}"
                        IsEnabled="{Binding CanCreate}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="#22C55E" 
                 Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Crear familia en Revit"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
