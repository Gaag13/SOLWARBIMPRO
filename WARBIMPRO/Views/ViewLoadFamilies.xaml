<Window x:Class="WARBIMPRO.Views.ViewLoadFamilies"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        
        mc:Ignorable="d"
        Height="300" Width="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="ViewLoadFamilies">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="#2C2C54">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════ -->
            <!-- BARRA DE TÍTULO                            -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#23234A"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28"
                                Background="#3498db"
                                CornerRadius="6"
                                Margin="0,0,10,0">
                            <!-- Ícono de librería / carpeta -->
                            <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Fill="White"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Library Settings"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="WARBIMPRO · Revit Tools"
                                       Foreground="#6060A0"
                                       FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE949;"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeWindow_Click"
                                ToolTip="Minimizar"/>
                        <Button Content="&#xE8BB;"
                                Click="CloseWindow_Click"
                                ToolTip="Cerrar">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Separador con gradiente -->
            <Rectangle Grid.Row="1" Height="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3498db" Offset="0"/>
                        <GradientStop Color="#4B4B7A" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ══════════════════════════════════════════ -->
            <!-- CONTENIDO PRINCIPAL                        -->
            <!-- ══════════════════════════════════════════ -->
            <StackPanel Grid.Row="2" Margin="24,20,24,10">

                <!-- ── Default Library ── -->
                <TextBlock Text="DEFAULT LIBRARY"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0,0,0,10"/>

                <Border Background="#23234A"
                        CornerRadius="6"
                        Padding="14,10"
                        Margin="0,0,0,18">
                    <CheckBox IsChecked="{Binding LoadBasicOnStartup}"
                              Style="{StaticResource CheckBoxStyle}">
                        <CheckBox.Content>
                            <StackPanel>
                                <TextBlock Text="Load basic families on startup"
                                           Foreground="White"
                                           FontSize="12"/>
                                <TextBlock Text="Carga automática al abrir Revit"
                                           Foreground="#6060A0"
                                           FontSize="10"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                </Border>

                <!-- ── Custom Library Path ── -->
                <TextBlock Text="CUSTOM LIBRARY PATH"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#23234A"
                            BorderBrush="#4B4B7A"
                            BorderThickness="1"
                            CornerRadius="6,0,0,6">
                        <TextBox Text="{Binding CustomLibraryPath}"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Padding="10,8"
                                 VerticalAlignment="Center"
                                 CaretBrush="White"/>
                    </Border>

                    <Button Grid.Column="1"
                            Command="{Binding BrowserPathCommand}"
                            Width="80"
                            Height="36"
                            Cursor="Hand"
                            ToolTip="Seleccionar carpeta">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498db"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="0,6,6,0"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                                          Fill="White"
                                                          Width="12" Height="12"
                                                          Stretch="Uniform"
                                                          Margin="0,0,5,0"/>
                                                    <TextBlock Text="Browse"
                                                               Foreground="White"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2980b9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1f6fa3"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

            </StackPanel>

            <!-- ══════════════════════════════════════════ -->
            <!-- FOOTER CON BOTÓN                           -->
            <!-- ══════════════════════════════════════════ -->
            <Border Grid.Row="3"
                    Background="#23234A"
                    CornerRadius="0,0,10,10"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Selecciona una carpeta para comenzar"
                               Foreground="#6060A0"
                               FontSize="11"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding LoadNowCommand}"
                            Height="34"
                            Width="110"
                            Padding="18,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#3498db"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <Path Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                                          Fill="White"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          Margin="0,0,8,0"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#2980b9"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#1f6fa3"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#4B4B7A"/>
                                                    <Setter Property="Foreground" Value="#7A7AAA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="Load" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
