<Window x:Class="WARBIMPRO.Views.ViewLoadFamilies"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Height="280" Width="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="ViewLoadFamilies">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border CornerRadius="10" Background="#2C2C54">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════ TITLE BAR ══════════════════ -->
            <Border Grid.Row="0"
                    Background="#23234A"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" Background="#3498db" CornerRadius="6" Margin="0,0,10,0">
                            <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                  Fill="White" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Library Settings" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="WARBIMPRO · Revit Tools" Foreground="#6060A0" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="&#xE949;"
                                Style="{StaticResource WindowButtonStyle}"
                                Click="MinimizeWindow_Click"
                                ToolTip="Minimizar"/>
                        <Button Content="&#xE8BB;" Click="CloseWindow_Click" ToolTip="Cerrar">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#C0392B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Separador -->
            <Rectangle Grid.Row="1" Height="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3498db" Offset="0"/>
                        <GradientStop Color="#4B4B7A" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ══════════════════ CONTENIDO ══════════════════ -->
            <StackPanel Grid.Row="2" Margin="24,20,24,20">

                <!-- ── SECCIÓN PRINCIPAL: Custom Library Path ── -->
                <TextBlock Text="CUSTOM LIBRARY PATH" Style="{StaticResource SectionLabelStyle}"/>

                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Path input -->
                    <Border Grid.Column="0"
                            Background="#1E1E42"
                            BorderBrush="#4B4B7A"
                            BorderThickness="1"
                            CornerRadius="5,0,0,5">
                        <TextBox Text="{Binding CustomLibraryPath}"
                                 Background="Transparent"
                                 Foreground="White"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Padding="10,8"
                                 VerticalAlignment="Center"
                                 CaretBrush="White"/>
                    </Border>

                    <!-- Browse button -->
                    <Button Grid.Column="1"
                            Command="{Binding BrowserPathCommand}"
                            Content="Browse"
                            Style="{StaticResource BtnReset}"
                            BorderThickness="1,1,1,1"
                            ToolTip="Seleccionar carpeta"/>

                    <!-- Load button -->
                    <Button Grid.Column="2"
                            Command="{Binding LoadNowCommand}"
                            Content="Load Families"
                            Style="{StaticResource BtnPrimary}"
                            Margin="8,0,0,0"/>
                </Grid>

                <!-- ── SECCIÓN SECUNDARIA: Default Library ── -->
                <TextBlock Text="DEFAULT LIBRARY" Style="{StaticResource SectionLabelStyle}"/>

                <Border Background="#23234A" CornerRadius="6" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding LoadBasicOnStartup}"
                                  Style="{StaticResource CheckBoxStyle}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Load basic families on startup" Foreground="White" FontSize="12"/>
                            <TextBlock Text="Carga automática al abrir Revit" Foreground="#6060A0" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>

        </Grid>
    </Border>
</Window>