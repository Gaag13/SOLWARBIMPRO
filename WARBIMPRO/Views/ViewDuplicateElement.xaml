<Window x:Class="WARBIMPRO.Views.ViewDuplicateElement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:WARBIMPRO.Views.Converters"
        xmlns:local="clr-namespace:WARBIMPRO.Views"
        mc:Ignorable="d"
        Height="520" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Title="Duplicar Elemento">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Contenedor principal con borde redondeado -->
    <Border Background="#1E1E3F"
            BorderBrush="#4B4B7A"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barra de título personalizada -->
            <Border Grid.Row="0"
                    Background="#2C2C54"
                    CornerRadius="10,10,0,0">
                <Grid>
                    <TextBlock Text="✦  Duplicar Elemento"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>
                    <!-- Botón cerrar -->
                    <Button Content="&#xE106;"
                            Style="{StaticResource WindowButtonStyle}" Click="CloseButton_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,5,0"/>
                </Grid>
            </Border>

            <!-- Contenido -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,15,20,20">

                    <!-- ══ CATEGORÍA ══ -->
                    <TextBlock Text="CATEGORÍA"
                               Style="{StaticResource TextBlockStyle}"
                               FontSize="10"
                               Foreground="#3498db"
                               FontWeight="Bold"                              
                               Margin="0,0,0,4"/>

                    <Border Background="#2C2C54"
                            BorderBrush="#4B4B7A"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding CategoryName}"
                                   Foreground="White"
                                   FontSize="13"/>
                    </Border>

                    <!-- ══ NOMBRE ORIGINAL ══ -->
                    <TextBlock Text="TIPO ORIGINAL"
                               Style="{StaticResource TextBlockStyle}"
                               FontSize="10"
                               Foreground="#3498db"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>

                    <Border Background="#2C2C54"
                            BorderBrush="#4B4B7A"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding OriginalTypeName}"
                                   Foreground="#A0A0C0"
                                   FontSize="13"
                                   FontStyle="Italic"/>
                    </Border>

                    <!-- ══ NOMBRE NUEVO TIPO ══ -->
                    <TextBlock Text="NOMBRE NUEVO TIPO"
                               Style="{StaticResource TextBlockStyle}"
                               FontSize="10"
                               Foreground="#3498db"
                               FontWeight="Bold"
                               Margin="0,0,0,4"/>

                    <TextBox Text="{Binding NewTypeName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchBoxStyle}"
                             Height="34"
                             FontSize="13"
                             Margin="0,0,0,8"/>

                   

                    <!-- ══ PARÁMETROS ══ -->

                    <!-- Wall / Floor -->
                    <StackPanel Visibility="{Binding IsWallOrFloor, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PARÁMETROS"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="10"
                                   Foreground="#3498db"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Espesor (m)"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="12"/>
                        <TextBox Text="{Binding ParamValue1}"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Height="34"
                                 FontSize="13"
                                 Margin="0,0,0,14"/>
                    </StackPanel>

                    <!-- Framing / Column -->
                    <StackPanel Visibility="{Binding IsFramingOrColumn, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PARÁMETROS"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="10"
                                   Foreground="#3498db"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Base (b)"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="12"/>
                        <TextBox Text="{Binding ParamValue1}"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Height="34"
                                 FontSize="13"
                                 Margin="0,0,0,10"/>
                        <TextBlock Text="Altura (h)"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="12"/>
                        <TextBox Text="{Binding ParamValue2}"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Height="34"
                                 FontSize="13"
                                 Margin="0,0,0,14"/>
                    </StackPanel>

                    <!-- Foundation -->
                    <StackPanel Visibility="{Binding IsFoundation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="PARÁMETROS"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="10"
                                   Foreground="#3498db"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Ancho"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="12"/>
                        <TextBox Text="{Binding ParamValue1}"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Height="34"
                                 FontSize="13"
                                 Margin="0,0,0,10"/>
                        <TextBlock Text="Largo"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="12"/>
                        <TextBox Text="{Binding ParamValue2}"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Height="34"
                                 FontSize="13"
                                 Margin="0,0,0,10"/>
                        <TextBlock Text="Espesor"
                                   Style="{StaticResource TextBlockStyle}"
                                   FontSize="12"/>
                        <TextBox Text="{Binding ParamValue3}"
                                 Style="{StaticResource SearchBoxStyle}"
                                 Height="34"
                                 FontSize="13"
                                 Margin="0,0,0,14"/>
                    </StackPanel>

                    <!-- ══ BOTÓN ══ -->
                    <Button Content="⧉  Duplicar y Modificar"
                            Command="{Binding DuplicateCommand}"
                            Style="{StaticResource ButtonStyle}"
                            Height="38"
                            Width="200"
                            FontSize="13"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
