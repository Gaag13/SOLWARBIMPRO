<Window x:Class="WARBIMPRO.Views.ViewDuplicateElement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WARBIMPRO.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ViewDuplicateElement">

    <StackPanel Margin="15">

        <TextBlock Text="Nombre nuevo tipo" FontWeight="Bold"/>
        <TextBox Text="{Binding NewTypeName}" Margin="0,5,0,10"/>

        <DataGrid ItemsSource="{Binding Parameters}"
              AutoGenerateColumns="False"
              CanUserAddRows="False">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Parámetro"
                                Binding="{Binding Name}"
                                IsReadOnly="True"/>

                <DataGridTextColumn Header="Valor"
                                Binding="{Binding Value, Mode=TwoWay}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Content="Duplicar"
            Command="{Binding DuplicateCommand}"
            Margin="0,10,0,0"/>
    </StackPanel>
</Window>
