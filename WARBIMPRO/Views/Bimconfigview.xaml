<Window x:Class="WARBIMPRO.Views.BimConfigView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:WARBIMPRO.ViewModels"        
        mc:Ignorable="d"
        Title="Configuración Claude API — WARBIMPRO"
        Width="460" Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E42"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TITLEBAR ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#16163A" BorderBrush="#4B4B7A" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Width="26" Height="26" CornerRadius="5" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3498DB" Offset="0"/>
                                <GradientStop Color="#4B4B7A" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚙" Foreground="White" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Configuración Claude API"
                               Style="{StaticResource TextBlockStyle}"
                               FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Margin="0"/>
                    <Border Margin="10,0,0,0" CornerRadius="10"
                            Background="#1E2847" BorderBrush="#3498DB"
                            BorderThickness="1" Padding="7,2">
                        <TextBlock Text="WARBIMPRO" Foreground="#3498DB"
                                   FontSize="9" FontWeight="Bold" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>

                <Button Content="&#xE106;" Style="{StaticResource WindowButtonStyle}"
                        Click="CloseButton_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,5,0"/>
            </Grid>
        </Border>

        <!-- ══ CONTENIDO ══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="1" Margin="20,16,20,0">

            <!-- API Key -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Ellipse Width="7" Height="7" Fill="#3498DB"
                         Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="CLAUDE API KEY"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0" VerticalAlignment="Center"/>
            </StackPanel>

            <Border CornerRadius="5" Background="#16163A"
                    BorderBrush="#4B4B7A" BorderThickness="1"
                    Margin="0,0,0,4">
                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                         Foreground="#CCCCEE" Background="Transparent"
                         BorderThickness="0" FontFamily="Consolas" FontSize="11"
                         Padding="10,8" CaretBrush="#3498DB"/>
            </Border>

            <Border CornerRadius="8" Background="#1A2847"
                    BorderBrush="#3498DB" BorderThickness="1"
                    Padding="10,6" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="sk-ant-..." Foreground="#3498DB"
                               FontFamily="Consolas" FontSize="9"
                               FontWeight="Bold" Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Foreground="#7A7AAA" FontSize="10" VerticalAlignment="Center">
                        <Run Text="Obtén tu key en "/>
                        <Run Text="console.anthropic.com"
                             Foreground="#3498DB" FontFamily="Consolas"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Biblioteca JSON -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Ellipse Width="7" Height="7" Fill="#3498DB"
                         Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="CARPETA BIBLIOTECA JSON  (opcional)"
                           Style="{StaticResource SectionLabelStyle}"
                           Margin="0" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="5" Background="#16163A"
                        BorderBrush="#4B4B7A" BorderThickness="1">
                    <TextBox Text="{Binding LibraryPath, UpdateSourceTrigger=PropertyChanged}"
                             Foreground="#CCCCEE" Background="Transparent"
                             BorderThickness="0" FontFamily="Consolas" FontSize="11"
                             Padding="10,8" CaretBrush="#3498DB"/>
                </Border>

                <Button Grid.Column="1" Margin="6,0,0,0"
                        Style="{StaticResource BtnSecondary}"
                        Command="{Binding BrowseFolderCommand}">
                    <TextBlock Text="..." FontFamily="Consolas" FontSize="13"/>
                </Button>
            </Grid>

        </StackPanel>

        <!-- ══ ACTION BAR ════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#16163A" BorderBrush="#4B4B7A" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status -->
                <Border Grid.Column="0" CornerRadius="20" Background="#2C2C54"
                        BorderBrush="#4B4B7A" BorderThickness="1"
                        Padding="12,5" Margin="0,0,8,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="#7A7AAA"
                               FontSize="11" FontFamily="Consolas"
                               VerticalAlignment="Center"/>
                </Border>

                <Button Grid.Column="1" Margin="0,0,6,0"
                        Style="{StaticResource BtnReset}"
                        Command="{Binding CancelCommand}">
                    <TextBlock Text="Cancelar"/>
                </Button>

                <Button Grid.Column="2"
                        Style="{StaticResource BtnPrimary}"
                        Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="Guardar"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
