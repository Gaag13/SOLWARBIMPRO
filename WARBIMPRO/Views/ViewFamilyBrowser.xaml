<UserControl x:Class="WARBIMPRO.Views.ViewFamilyBrowser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:WARBIMPRO.Views.Converters"
             mc:Ignorable="d"       
             d:DesignHeight="500" d:DesignWidth="350"
             Background="#F5F5F5">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>

            <!-- Botón circular "Place" reutilizable -->
            <Style x:Key="PlaceButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#3498DB"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="10,6">
                                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                          Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                                    <TextBlock Text="Place" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#2980B9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#21618C"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#3A3A5C" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="28" Height="28" Background="#3498DB" CornerRadius="6" Margin="0,0,10,0">
                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                          Fill="White" Width="14" Height="14" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Grid.Column="1"
                           Text="Family Browser" 
                           FontSize="16" 
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Buscador -->
        <Border Grid.Row="1" 
                Background="White"
                Padding="10"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#F8F9FA"
                        BorderBrush="#CFD8DC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Path Grid.Column="0"
                              Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                              Fill="#90A4AE" Width="13" Height="13" Stretch="Uniform"
                              VerticalAlignment="Center" Margin="0,0,8,0"/>

                        <Grid Grid.Column="1">
                            <TextBlock Text="Search families or types..."
                                       FontSize="13"
                                       Foreground="#90A4AE"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TextoBusqueda}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TextoBusqueda}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="13"
                                     VerticalAlignment="Center"
                                     Padding="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Botón limpiar -->
                <Button Grid.Column="1"
                        Command="{Binding LimpiarBusquedaCommand}"
                        Width="36"
                        Height="36"
                        Margin="8,0,0,0"
                        Cursor="Hand"
                        ToolTip="Clear search">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#E74C3C"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <Path Data="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Fill="White" Width="13" Height="13" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#A93226"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- TreeView -->
        <ScrollViewer Grid.Row="2" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="5">
            <TreeView Background="Transparent" 
                      BorderThickness="0"
                      ItemsSource="{Binding CategoriaFamiliasFiltradas}">
                <TreeView.ItemTemplate>

                    <!-- NIVEL 1: CATEGORÍA -->
                    <HierarchicalDataTemplate ItemsSource="{Binding Familias}">
                        <Border Background="White" 
                                Padding="10,8" 
                                Margin="0,2"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Width="28" Height="28"
                                        Background="#3A3A5C"
                                        CornerRadius="4"
                                        Margin="0,0,10,0">
                                    <Path Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                                          Fill="White" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding NombreCategoria}" 
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="#3A3A5C"/>

                                <Border Grid.Column="2"
                                        Background="#3A3A5C"
                                        CornerRadius="12"
                                        Padding="8,3">
                                    <TextBlock Text="{Binding Familias.Count}" 
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- NIVEL 2: FAMILIA -->
                        <HierarchicalDataTemplate.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Tipos}">
                                <Border Background="#F8F9FA"
                                        Padding="8,6"
                                        Margin="20,2,0,2"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="#D0D0D0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" 
                                                Width="24" Height="24"
                                                Background="#666"
                                                CornerRadius="3"
                                                Margin="0,0,8,0">
                                            <Path Data="M3 5h18v2H3V5zm0 6h18v2H3v-2zm0 6h18v2H3v-2z"
                                                  Fill="White" Width="12" Height="12" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding NombreFamilia}" 
                                                   FontWeight="Medium"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="#333"/>

                                        <Border Grid.Column="2"
                                                Background="#666"
                                                CornerRadius="10"
                                                Padding="6,2">
                                            <TextBlock Text="{Binding Tipos.Count}" 
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- NIVEL 3: TIPOS -->
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White"
                                                Padding="10"
                                                Margin="40,2,0,2"
                                                CornerRadius="4"
                                                BorderThickness="1"
                                                BorderBrush="#E0E0E0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="4" 
                                                                              ShadowDepth="1" 
                                                                              Opacity="0.1"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8F9FA"/>
                                                            <Setter Property="BorderBrush" Value="#3498DB"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <!-- Layout vertical: imagen+nombre arriba, botón abajo a ancho completo -->
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="48" Height="48"
                                                            Background="#ECEFF1"
                                                            BorderBrush="#CFD8DC"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="0,0,10,0">
                                                        <Grid>
                                                            <Image Source="{Binding Preview}" 
                                                                   Stretch="Uniform"
                                                                   Margin="2">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Source" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <Path Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                                                  Fill="#B0BEC5" Width="20" Height="20" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Grid>
                                                    </Border>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding NombreTipo}" 
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Foreground="#2C3E50"/>
                                                </Grid>

                                                <Button HorizontalAlignment="Stretch"
                                                        ToolTip="Place Family"
                                                        Style="{StaticResource PlaceButtonStyle}"
                                                        Command="{Binding DataContext.ColocarFamiliaCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </ScrollViewer>
    </Grid>
</UserControl>