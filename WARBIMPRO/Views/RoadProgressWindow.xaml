<Window x:Class="WARBIMPRO.Views.RoadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WARBIMPRO.Views"
        Height="220" Width="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Title="RoadProgressWindow">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GlobalStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Animación de rotación continua para el spinner -->
            <Storyboard x:Key="SpinAnimation" RepeatBehavior="Forever">
                <DoubleAnimation
          Storyboard.TargetName="SpinnerRotate"
          Storyboard.TargetProperty="Angle"
          From="0" To="360"
          Duration="0:0:1"/>
            </Storyboard>

        </ResourceDictionary>
      

    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpinAnimation}"/>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="10" Background="#2C2C54">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- TÍTULO -->
            <Border Grid.Row="0" Background="#23234A" CornerRadius="10,10,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28"
                                Background="#2B6CB0"
                                CornerRadius="6"
                                Margin="0,0,10,0">
                            <Path Data="M1.5 6.5A5 5 0 0 1 11.5 6.5V14L6.5 17L1.5 14Z"
                                  Fill="White" Width="14" Height="14"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Generando Vía y Andenes"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="WARBIMPRO · Revit Tools"
                                       Foreground="#6060A0" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Separador -->
            <Rectangle Grid.Row="1" Height="1">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2B6CB0" Offset="0"/>
                        <GradientStop Color="#4B4B7A" Offset="0.5"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- CONTENIDO -->
            <StackPanel Grid.Row="2" Margin="24,16,24,10" VerticalAlignment="Center">

                <!-- Status + Spinner en la misma fila -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusText}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <!-- Spinner — visible solo cuando NO está completado -->
                    <Grid Grid.Column="1"
                          Width="18" Height="18"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.RenderTransformOrigin>0.5, 0.5</Grid.RenderTransformOrigin>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                        </Grid.RenderTransform>

                        <!-- Arco del spinner — círculo con gap -->
                        <Ellipse Width="18" Height="18"
                                 StrokeThickness="2.5"
                                 Stroke="#4B4B7A"/>
                        <Ellipse Width="18" Height="18"
                                 StrokeThickness="2.5">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#63B3ED" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="0.75"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>
                    </Grid>
                </Grid>

                <!-- Barra de progreso -->
                <Grid>
                    <Border Background="#1A1A3A" CornerRadius="6" Height="14"/>
                    <Border CornerRadius="6" Height="14" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2B6CB0" Offset="0"/>
                                            <GradientStop Color="#63B3ED" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Border.Style>
                        <Border.Width>
                            <MultiBinding>
                                <MultiBinding.Converter>
                                    <local:PercentToWidthConverter/>
                                </MultiBinding.Converter>
                                <Binding Path="Progress"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=Grid}"
                                         Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Grid>

                <!-- Porcentaje -->
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Right"
                           Foreground="#63B3ED"
                           FontSize="12"
                           FontWeight="SemiBold">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}%">
                            <Binding Path="Progress"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

            </StackPanel>

            <!-- FOOTER -->
            <Border Grid.Row="3" Background="#23234A"
                    CornerRadius="0,0,10,10" Padding="20,12">
                <Button Content="Cerrar"
                        Click="CloseButton_Click"
                        Height="34" Width="100"
                        HorizontalAlignment="Right"
                        Cursor="Hand"
                        IsEnabled="{Binding IsCompleted}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6" Padding="12,0">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A4F8A"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#3A3A5C"/>
                                                <Setter Property="Foreground" Value="#6060A0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="True">
                                    <Setter Property="Background" Value="#2B6CB0"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#3A3A5C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>

        </Grid>
    </Border>
</Window>
